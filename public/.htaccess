# Apache config for cPanel shared hosting.
#
# Vite copies public/ into dist/, so this ships to the server root alongside
# index.html. There is deliberately no SPA catch-all rewrite: the site is a
# single page with anchor links, no client-side router, and a catch-all would
# only put robots.txt, sitemap.xml and llms.txt at risk.

# ---------------------------------------------------------------------------
# Canonical host and scheme
#
# IMPORTANT: issue the certificate first (cPanel > SSL/TLS Status > Run AutoSSL).
# Forcing HTTPS before a cert exists makes the site unreachable.
#
# Sends everything to https://ranonline-egames.com, matching the canonical tag
# and sitemap. Two URLs serving the same page is a duplicate-content split.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://ranonline-egames.com/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://ranonline-egames.com/$1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caching
#
# Vite fingerprints filenames in /assets, so those can be cached forever.
# index.html must not be, or visitors keep loading a stale build after deploy.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|png|jpe?g|svg|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType application/manifest+json .webmanifest
</IfModule>

# Directory listings off
Options -Indexes
