# Game server API, read by the proxies that answer /api/* on this site.
#
# Deliberately not VITE_-prefixed: these are server-side only. A VITE_ variable
# is inlined into the client bundle, which would put the token in public JS.
#
# Local: copy this file to .env.local (gitignored) and fill in the token.
#        For the real Cloudflare Functions, put the same names in .dev.vars and
#        run `npx wrangler pages dev dist`.
# Production: set the same names on the Cloudflare Pages project, under
#             Settings -> Environment variables.
#
# GAME_API_ORIGIN is the origin only. Paths live in server/routes.ts, so one
# variable covers every endpoint. It is optional; server/routes.ts holds the
# default. STATS_API_TOKEN has no default on purpose: an unset token fails
# loudly upstream rather than shipping a secret in the repo.

GAME_API_ORIGIN=http://egames.ran-services.com
STATS_API_TOKEN=
