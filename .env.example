# Live server stats, read by the /api/stats proxy.
#
# Deliberately not VITE_-prefixed: these are server-side only. A VITE_ variable
# is inlined into the client bundle, which would put the token in public JS.
#
# Local: copy this file to .env.local (gitignored) and fill it in.
# Production: set the same two names on the Cloudflare Pages project, under
# Settings -> Environment variables.

STATS_API_URL=http://egames.ran-services.com/api/stats
STATS_API_TOKEN=
